{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "feature",
        "update",
        "referral",
        "community",
        "important"
      ],
      "default": "update"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "content"
  ]
}