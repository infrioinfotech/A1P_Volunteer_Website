{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string"
    },
    "referred_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "joined",
        "active"
      ],
      "default": "pending"
    },
    "joined_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "referrer_email",
    "referred_email"
  ]
}