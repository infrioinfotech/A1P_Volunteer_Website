{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "prayer_session",
        "training",
        "community_gathering",
        "webinar",
        "other"
      ],
      "default": "prayer_session"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60
    },
    "location": {
      "type": "string"
    },
    "is_virtual": {
      "type": "boolean",
      "default": true
    },
    "meeting_link": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}