{
  "name": "ImpactStory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "healing",
        "provision",
        "restoration",
        "guidance",
        "miracle"
      ],
      "default": "guidance"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "story"
  ]
}